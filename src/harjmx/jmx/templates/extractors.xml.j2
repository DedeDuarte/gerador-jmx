{% macro json_extractor(nome, variavel, expressao, match) -%}
<JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="{{ nome }}" enabled="true">
  <stringProp name="JSONPostProcessor.referenceNames">{{ variavel }}</stringProp>
  <stringProp name="JSONPostProcessor.jsonPathExprs">{{ expressao }}</stringProp>
  <stringProp name="JSONPostProcessor.match_numbers">{{ match }}</stringProp>
  <stringProp name="JSONPostProcessor.defaultValues">{{ variavel }}_ERR</stringProp>
</JSONPostProcessor>
{%- endmacro %}

{% macro regex_extractor(nome, variavel, expressao, campo, match) -%}
<RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="{{ nome }}" enabled="true">
  <stringProp name="RegexExtractor.useHeaders">{{ campo == "headers" }}</stringProp>
  <stringProp name="RegexExtractor.refname">{{ variavel }}</stringProp>
  <stringProp name="RegexExtractor.regex">{{ expressao }}</stringProp>
  <stringProp name="RegexExtractor.template">$1$</stringProp>
  <stringProp name="RegexExtractor.default">{{ variavel }}_ERR</stringProp>
  <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
  <stringProp name="RegexExtractor.match_number">{{ match }}</stringProp>
</RegexExtractor>
{%- endmacro %}
